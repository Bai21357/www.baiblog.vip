---
// src/components/widget/Profile.astro
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;

// 头像跳转链接（来自配置）
const redirectUrl = config.avatarRedirect || "/about/";
const isExternal = redirectUrl.startsWith("http");
---

<div class="card-base p-3">
    <!-- 头像区域（带跳转和悬停动画） -->
    <a
            href={redirectUrl}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
            class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
           max-w-[12rem] lg:max-w-none overflow-hidden rounded-xl active:scale-95"
    >
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
                w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl" />
        </div>
        <ImageWrapper
                src={url(config.avatar)}
                alt={config.name}
                class="w-32 h-32 lg:w-48 lg:h-48 rounded-full mx-auto object-cover"
                position="center"
                basePath="/"
        />
    </a>

    <!-- 直播状态显示区域 -->
    <div id="live-status-container" class="text-center mt-2"></div>

    <!-- 姓名和简介 -->
    <div class="mt-4 text-center">
        <div class="text-lg font-medium">{config.name}</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">{config.bio}</div>
    </div>

    <!-- 社交链接 -->
    {config.links.length > 0 && (
            <div class="flex justify-center space-x-4 mt-4">
                {config.links.map((item) => (
                        <a
                                href={item.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
                        >
                            <Icon name={item.icon} class="w-5 h-5" />
                        </a>
                ))}
            </div>
    )}
</div>

<script>
    (function() {
        const ROOM_ID = "30582788";          // 你的房间号
        const CACHE_KEY = `LIVE_STATUS_${ROOM_ID}`;
        const container = document.getElementById('live-status-container');
        if (!container) return;

        // 辅助：生成 HTML 字符串（用于比较和渲染）
        function generateStatusHtml(result) {
            if (!result || result.code === undefined) return null;

            // 正常数据
            if (result.code === 0 && result.data) {
                const liveStatus = result.data.live_status;
                const roomId = result.data.room_id;
                const title = result.data.title || '直播中';

                if (liveStatus === 1) {
                    return `
            <a href="https://live.bilibili.com/${roomId}" target="_blank" rel="noopener noreferrer" 
               class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-500 hover:bg-red-600 transition-colors text-white text-sm font-medium">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
              </span>
              🔴 ${escapeHtml(title)}
            </a>
          `;
                } else {
                    return `<span class="text-gray-500 dark:text-gray-400 text-sm">⚫ 未开播</span>`;
                }
            }
            // 房间不存在
            else if (result.code === 1 && result.msg === '未找到该房间') {
                return `<span class="text-gray-500 dark:text-gray-400 text-sm">⚫ 未开播</span>`;
            }
            // 风控
            else if (result.code === -352) {
                console.warn('[直播状态] B站风控 -352');
                return `<span class="text-gray-500 dark:text-gray-400 text-sm">⚠️ 状态查询受限</span>`;
            }
            // 其他错误
            else {
                console.error('[直播状态] 异常返回:', result);
                return `<span class="text-gray-500 dark:text-gray-400 text-sm">⚠️ 接口异常</span>`;
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

        // 渲染：只有内容变化时才更新 DOM
        let currentHtml = null;
        function renderLiveStatus(result) {
            const newHtml = generateStatusHtml(result);
            if (newHtml !== null && newHtml !== currentHtml) {
                currentHtml = newHtml;
                container.innerHTML = newHtml;
            }
        }

        // 优先显示缓存（无加载提示）
        const cached = localStorage.getItem(CACHE_KEY);
        if (cached) {
            try {
                const data = JSON.parse(cached);
                const html = generateStatusHtml(data);
                if (html) {
                    currentHtml = html;
                    container.innerHTML = html;
                }
            } catch(e) {}
        }

        // 请求最新数据并更新缓存
        async function fetchAndUpdate() {
            try {
                const response = await fetch(`/bili-api/room/v1/Room/get_info?room_id=${ROOM_ID}`);
                const data = await response.json();
                localStorage.setItem(CACHE_KEY, JSON.stringify(data));
                renderLiveStatus(data);
            } catch (err) {
                console.error('[直播状态] 请求失败:', err);
                if (!localStorage.getItem(CACHE_KEY)) {
                    const fallbackHtml = `<span class="text-gray-500 dark:text-gray-400 text-sm">⚠️ 状态获取失败</span>`;
                    if (fallbackHtml !== currentHtml) {
                        currentHtml = fallbackHtml;
                        container.innerHTML = fallbackHtml;
                    }
                }
            }
        }

        fetchAndUpdate();
        setInterval(fetchAndUpdate, 120000);
    })();
</script>
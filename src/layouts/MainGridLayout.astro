---
import Layout from "./Layout.astro";
import NavBar from "@/components/NavBar.astro";
import Footer from "@/components/Footer.astro";
import Toc from "@/components/Toc.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import SiteInfo from "@/components/SiteInfo.astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  banner?: string;
  setOGTypeArticle?: boolean;
  headings?: any[];
  post?: CollectionEntry<"posts">;
}

const {
  title,
  description,
  lang = "zh-CN",
  banner,
  setOGTypeArticle = false,
  headings = [],
  post,
} = Astro.props;

import siteConfig from "@/config";
const h1Text = title || siteConfig.title;

const jsonLd = post ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description || siteConfig.description,
  datePublished: post.data.published,
  dateModified: post.data.updated || post.data.published,
  author: {
    "@type": "Person",
    name: siteConfig.author.name,
    url: siteConfig.author.url,
  },
  image: post.data.coverImage || siteConfig.banner?.src,
  url: Astro.url.href,
  publisher: {
    "@type": "Organization",
    name: siteConfig.title,
    logo: {
      "@type": "ImageObject",
      url: siteConfig.logo?.src,
    },
  },
} : null;
---

<Layout
  title={title}
  description={description}
  lang={lang}
  banner={banner}
  setOGTypeArticle={setOGTypeArticle}
>
  <!-- 文章结构化数据（仅文章页） -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <div class="flex flex-col min-h-screen">
    <NavBar />

    <div class="flex-1 flex flex-col lg:flex-row max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8">
      <main class="flex-1 min-w-0 py-8 lg:py-12">
        <h1 class="text-3xl sm:text-4xl font-bold mb-6">{h1Text}</h1>

        <slot />
      </main>

      <aside class="lg:w-72 lg:ml-8 xl:ml-12 flex-shrink-0">
        {headings && headings.length > 0 ? (
          <TableOfContents headings={headings} />
        ) : (
          <SiteInfo />
        )}
      </aside>
    </div>

    <Footer />
  </div>
</Layout>
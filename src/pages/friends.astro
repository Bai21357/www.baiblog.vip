---

import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const friendsPost = await getEntry('spec', 'friends')
const { Content } = await render(friendsPost)
const items = [
    {
        title: 'LegspCpd',
        imgurl: 'https://hub.legspcpd.top/file/1786478720569_b_98f8cf789dc723b202017adcb82a0da9.jpg',
        desc: '初听不知曲中意，再听已是曲中人。',
        siteurl: 'https://blog.legspcpd.top',
        tags: ['Friends'],
    },
    {
        title: 'Kelojonle',
        imgurl: 'https://cdn.luogu.com.cn/upload/usericon/1259932.png',
        desc: '孤舟蓑笠翁，独钓寒江雪。',
        siteurl: 'https://www.cnblogs.com/Kelojonle',
        tags: ['Friends'],
    },

    {
        title: 'HJYH012',
        imgurl: 'https://cdn.luogu.com.cn/upload/usericon/1402105.png',
        desc: '你说得对',
        siteurl: 'https://hjyh012.github.io/',
        tags: ['Friends'],
    },
    {
        title: '二叉树树',
        imgurl: 'https://q2.qlogo.cn/headimg_dl?dst_uin=2726730791&spec=0',
        desc: 'Protect What You Love.',
        siteurl: 'https://2x.nz/',
        tags: ['Friends'],
    },
    {
        title: 'THWs Blog',
        imgurl: 'https://image.tianhw.top/avatar.webp',
        desc: '前途似海，来日方长',
        siteurl: 'https://blog.tianhw.top',
        tags: ['Friends'],
    },
    {
        title: 'yhlhoh',
        imgurl: 'https://www.y-dev.tech/_astro/avatar.5Ppcez4p_1HFgbj.webp',
        desc: '冀以尘雾之微，补益山海；荧烛末光，增辉日月。',
        siteurl: 'https://www.y-dev.tech/',
        tags: ['Friends'],
    },
    {
        title: 'Arcwolf Blog',
        imgurl: 'https://www.arcwolf.top/assets/home/28.png',
        desc: 'Nothing',
        siteurl: 'https://www.arcwolf.top',
        tags: ['Friends'],
    },
    {
        title: 'for_the_zero的小站',
        imgurl: 'https://ftz.is-a.dev/assets/intro/avatar.png',
        desc: '想要成为一个有趣的、厉害的、快乐的、善良的、……能被你记住的人',
        siteurl: 'https://ftz.is-a.dev/',
        tags: ['Friends'],
        },
    {
        title: 'Link',
        imgurl:' https://atlinker.cn/avatar/avatar.png',
        desc:  'Just 4 Fun',
        siteurl:'https://atlinker.cn',
        tags: ['Friends'],
    },

    {
        title: 'mccsjs',
        imgurl:'https://hexo.seln.cn/img/ico.jpg',
        desc:  '点一盏灯，等一个迷路的夜🍁🍁🍁',
        siteurl:'https://hexo.seln.cn/',
        tags: ['Friends'],
    },
    {
        title: 'RATING3PRO Blog',
        imgurl:'https://www.xie.today/images/avatar.jpg',
        desc:  'Share life',
        siteurl:'https://www.xie.today',
        tags: ['Friends'],
    },
    {
        title: 'SkyのXnok',
        imgurl:'https://201562.xyz/avatar.png',
        desc:  '记录学习、生活与思考',
        siteurl:'https://201562.xyz',
        tags: ['Friends'],
    },
]

const shuffledItems = [...items]
    .sort(() => Math.random() - 0.5);

const exampleCode = `{
    title: '名字',
    imgurl: 'https://xxxx.xx/xx.png',  #头像
    desc: 'saying',
    siteurl: '你的链接',
    tags: ['Friends'],
},`
---
<MainGridLayout title={i18n(I18nKey.friends)} description={i18n(I18nKey.friends)}>
    <h1 class="sr-only">{i18n(I18nKey.friends)}</h1>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-8 my-4">
                {shuffledItems.map((item) => (
                        <div class="flex flex-nowrap items-stretch h-28 gap-4 rounded-[var(--radius-large)]">
                            <div class="w-28 h-28 flex-shrink-0 rounded-lg overflow-hidden bg-zinc-200 dark:bg-zinc-900">
                                <img src={item.imgurl} alt="站点头像" class="w-full h-full object-cover">
                            </div>
                            <div class="grow w-full">
                                <div class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 mb-1">{item.title}</div>
                                <div class="text-50 text-sm font-medium">{item.desc}</div>
                                <div class:list={["items-center", {"flex": true, "hidden md:flex" : false}]}>
                                    <div class="flex flex-row flex-nowrap items-center">
                                        {(item.tags && item.tags.length > 0) && item.tags.map((tag,i) => (
                                                <div class:list={[{"hidden": i==0}, "mx-1.5 text-[var(--meta-divider)] text-sm" ]}>
                                                    /
                                                </div>
                                                <span class="transition text-50 text-sm font-medium">
                                        {tag}
                                    </span>))}
                                        {!(item.tags && item.tags.length > 0) && <div class="transition text-50 text-sm font-medium">{i18n(I18nKey.noTags)}</div>}
                                    </div>
                                </div>
                            </div>
                            <a href={item.siteurl} target="_blank" rel="noopener noreferrer"class="flex btn-regular w-[3.25rem] rounded-lg bg-[var(--enter-btn-bg)] hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95">
                                <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="transition text-[var(--primary)] text-4xl mx-auto iconify iconify--material-symbols" width="1em" height="1em" viewBox="0 0 24 24">
                                    <path fill="currentColor" d="M12.6 12L8.7 8.1q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.6 4.6q.15.15.213.325t.062.375t-.062.375t-.213.325l-4.6 4.6q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7z"></path>
                                </svg>
                            </a>
                        </div>
                ))}
            </div>
            <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 mt-8">花径不曾缘客扫，蓬门今始为君开</h2>
            <h4 class="font-medium text-neutral-900 dark:text-neutral-100 mt-2">欢迎！添加友链请在github提交pr</h4>
            <p class="mt-2 text-sm">
                <a href="https://github.com/Bai21357/www.baiblog.vip/blob/main/src/pages/friends.astro" title="友链文件" target="_blank" rel="noopener noreferrer" class="transition text-[var(--primary)] hover:underline">友链文件(github)</a>
            </p>
            <h4 class="font-medium text-neutral-900 dark:text-neutral-100 mt-4">代码示例</h4>
            <pre class="rounded-[var(--radius-large)] bg-zinc-100 dark:bg-zinc-900 p-4 overflow-x-auto text-sm leading-relaxed text-neutral-800 dark:text-neutral-100 mt-2"><code>{exampleCode}</code></pre>
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>

